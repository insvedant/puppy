{
  // Cloudflare Workers config, used by "npx wrangler deploy" (for example Workers Builds from GitHub).
  // Not needed for Pages drag-and-drop uploads.
  "name": "petite-paws",
  "main": "_worker.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*"]
  },

  // Paste your D1 Database ID (Cloudflare → Storage & Databases → D1 → petite-paws-db).
  "d1_databases": [
    { "binding": "DB", "database_name": "petite-paws-db", "database_id": "PASTE-YOUR-D1-DATABASE-ID-HERE" }
  ],

  // Photo uploads. Create the bucket first, or delete this block if you don't want uploads.
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "petite-paws-images" }
  ],

  "observability": { "enabled": true }
}
