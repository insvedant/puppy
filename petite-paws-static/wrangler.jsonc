{
  // Used for "Cloudflare Workers" deploys: npx wrangler deploy
  // (Cloudflare Pages ignores this file's main/assets and uses /public + /functions.)
  "name": "petite-paws",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
